{
  "version": 5,
  "configurePresets": [
    {
      "name": "desktop",
      "displayName": "Ninja + MSVC (x64)",
      "description": "Needs the MSVC environment (vcvars64); python Engine sets it up",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "APP_BUILD_GAME": "ON",
        "APP_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "tests",
      "inherits": "desktop",
      "displayName": "Headless tests (Debug only)",
      "binaryDir": "${sourceDir}/build/tests",
      "cacheVariables": {
        "APP_BUILD_GAME": "OFF",
        "APP_BUILD_TESTS": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "desktop", "configuration": "Debug" },
    { "name": "release", "configurePreset": "desktop", "configuration": "Release" },
    { "name": "tests-debug", "configurePreset": "tests", "configuration": "Debug", "targets": ["EngineTestSuite"] }
  ],
  "testPresets": [
    { "name": "tests-debug", "configurePreset": "tests", "configuration": "Debug",
      "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error", "jobs": 8 } }
  ]
}
