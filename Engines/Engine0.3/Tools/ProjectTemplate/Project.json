{
  "version": 1,
  "name": "@PROJECT_NAME@",
  "game": {
    "buildDirectory": "build",
    "configurePreset": "desktop",
    "buildPresets": { "Debug": "debug", "Release": "release" }
  },
  "release": {
    "directory": "Release",
    "notices": "Game/Distribution/GameNotices.txt",
    "files": []
  },
  "tests": {
    "buildDirectory": "build/tests",
    "configurePreset": "tests",
    "buildPreset": "tests-debug",
    "testPreset": "tests-debug"
  },
  "editor": {
    "buildDirectory": "build/editor",
    "cacheVariables": {
      "APP_BUILD_GAME": "OFF",
      "APP_BUILD_EDITOR": "ON",
      "APP_BUILD_TESTS": "OFF"
    }
  }
}
